# Environment Variables - Kopi Cerita
# Copy file ini ke .env dan isi dengan nilai yang sesuai

# ===========================================
# DATABASE
# ===========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/kopi_cerita"

# ===========================================
# NEXTAUTH
# ===========================================
# URL aplikasi (tanpa trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Secret untuk enkripsi session (WAJIB untuk production!)
# Generate dengan: openssl rand -base64 32
# Atau gunakan: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-super-secret-key-generate-new-one-for-production"

# ===========================================
# KOPIBOT AI
# ===========================================
# Optional. Jika key kosong atau provider error, KopiBot memakai fallback deterministic berbasis data internal.
# Pilihan: openai, gemini
AI_PROVIDER="openai"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
